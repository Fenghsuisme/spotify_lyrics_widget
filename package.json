{
  "name": "lyrics_widget",
  "productName": "LyricsWidget",
  "description": "A desktop widget for Spotify lyrics",
  "author": "Feng",
  "homepage": "./",
  "version": "0.1.0",
  "private": true,
  "main": "main.js",
  "dependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^13.5.0",
    "axios": "^1.13.5",
    "dotenv": "^17.3.1",
    "electron-is-dev": "^3.0.1",
    "electron-log": "^5.4.3",
    "express": "^5.2.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router-dom": "^7.13.0",
    "react-scripts": "5.0.1",
    "spotify-web-api-node": "^5.0.2",
    "web-vitals": "^2.1.4"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "electron": "40.0.0",
    "electron-builder": "^26.7.0",
    "wait-on": "^9.0.3"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "electron": "concurrently \"BROWSER=none react-scripts start\" \"wait-on http://127.0.0.1:3000 && electron .\"",
    "dist": "react-scripts build && electron-builder"
  },
  "build": {
    "extends": null,
    "appId": "com.feng.lyrics-widget",
    "productName": "LyricsWidget",
    "files": [
      "build",
      "node_modules",
      "main.js",
      "package.json",
      ".env"
    ],
    "extraResources": [
      {
        "from": "public/icon.png",
        "to": "icon.png"
      }
    ],
    "mac": {
      "category": "public.app-category.music",
      "icon": "public/icon.png",
      "target": [
        "dmg"
      ]
    },
    "win": {
      "target": "nsis",
      "icon": "public/icon.png"
    }
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
